<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.MeToYou.Settings.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/settings_card_background</item>
        <item name="cardCornerRadius">@dimen/settings_card_corner_radius</item>
        <item name="cardElevation">@dimen/settings_card_elevation</item>
        <item name="strokeColor">@color/settings_card_stroke</item>
        <item name="strokeWidth">@dimen/settings_card_stroke_width</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="rippleColor">@color/settings_ripple</item>
    </style>

    <style name="TextAppearance.MeToYou.Settings.HeaderTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_size_settings_header</item>
        <item name="android:textColor">@color/settings_header_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MeToYou.Settings.ItemTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_size_settings_title</item>
        <item name="android:textColor">@color/settings_title_text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MeToYou.Settings.ItemSubtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_size_settings_subtitle</item>
        <item name="android:textColor">@color/settings_subtitle_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.MeToYou.Settings.Value" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_size_settings_value</item>
        <item name="android:textColor">@color/settings_value_text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
